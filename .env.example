# API
API_PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/lms_platform?replicaSet=rs0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
WEB_ORIGIN=http://localhost:5173
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=1209600
PLATFORM_ADMIN_MFA_MAX_AGE_SECONDS=43200
PLATFORM_ADMIN_SENSITIVE_MFA_MAX_AGE_SECONDS=300
# Generate a unique local key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64URL_KEY

# Optional frontend override. Place this in apps/web/.env.local.
# Vite exposes VITE_ variables to browser code; never put secrets here.
VITE_API_BASE_URL=http://localhost:4000/api/v1
